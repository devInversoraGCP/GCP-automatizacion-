backups/
*.bak

# Secretos y entorno
.env
.env.*
*.env
secrets.*
**/NOTION_TOKEN*

# 🆕 Automatización Notion + correo F29 (doc 23)
# Volcados de la API (no commitear)
notion_automation/data/
# Logs del backend local (pueden contener estructura del payload con PII)
backend.log
backend.err
auditai.log
# Binario de ngrok (no pertenece al repo)
ngrok/

# ─── Python (Fase 2 en adelante) ───
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
build/
dist/
*.egg-info/
.eggs/

# Cachés de herramientas (uv, Ruff, mypy, pytest)
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.uv/

# ─── Editores / IDE ───
.vscode/
.idea/
*.swp

# ─── Sistema operativo ───
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store

# ─── Temporales ───
*.log
*.tmp
scratch/
tmp/

